// Phaingea · reglas de Realtime Database.
//
// Lectura abierta; la escritura va nodo a nodo validando la FORMA de los datos.
// No hay autenticacion real de Firebase (el login es propio, con hash), asi que
// las reglas no pueden comprobar el rol: quien gatea por rol es la interfaz.
// Es un modelo de confianza, adecuado para una wiki de rol entre amigos.
//
// OJO: esto se publica A MANO en la consola (Realtime Database > Reglas) cada
// vez que cambia este archivo. El editor de la consola acepta comentarios //.
{
  "rules": {
    ".read": true,
    ".write": false,

    "usuarios": {
      "$user": {
        ".write": "!data.exists() || !newData.exists()",
        ".validate": "newData.hasChildren(['pass','rol'])",
        "pass": { ".write": true, ".validate": "newData.isString() && newData.val().length < 300" },
        "rol":  { ".write": true, ".validate": "newData.isString() && newData.val().length < 30" },
        "nombreVisible": { ".write": true, ".validate": "newData.isString() && newData.val().length < 60" },
        "colorAvatar":   { ".write": true, ".validate": "newData.isString() && newData.val().length < 30" },
        "prefs":         { ".write": true },
        "$otro": { ".validate": false }
      }
    },

    // Guia 5-6. base-phaingea se puede editar pero no borrar.
    "campanas": {
      "base-phaingea": { ".write": "newData.exists()" },
      "$camp": {
        ".write": true,
        ".validate": "newData.hasChildren(['nombre', 'estado', 'orden'])",
        "nombre":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 80" },
        "estado":  { ".validate": "newData.isString() && (newData.val() == 'activa' || newData.val() == 'finalizada' || newData.val() == 'archivada' || newData.val() == 'privada')" },
        "orden":   { ".validate": "newData.isNumber()" },
        "descripcion": { ".validate": "newData.isString() && newData.val().length < 8000" }
      }
    },

    // Guia 22. /comentarios/{campana}/{tipo}/{ref}/{id}
    "comentarios": {
      "$camp": { "$tipo": { "$ref": { "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['autor', 'texto', 'fecha'])",
        "autor": { ".validate": "newData.isString() && newData.val().length < 60" },
        "texto": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 4000" }
      } } } }
    },

    // Guia 8.4. /planeta/{campana}/{lugar} = {lat, lon}
    // Los pines del globo son de CADA campana, aunque la cartografia se herede.
    "planeta": {
      "$camp": { "$lugar": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['lat','lon']) && newData.child('lat').isNumber() && newData.child('lon').isNumber())"
      } }
    },

    // Guia 10. /lugares/{campana}/{id}, con jerarquia via 'superior'.
    "lugares": {
      "$camp": { "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['nombre'])",
        "nombre": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 120" }
      } }
    },

    // Guia 11, 19-20. /personajes/{campana}/{id}
    "personajes": {
      "$camp": { "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['propietario', 'nombre', 'estado'])",
        "nombre": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 80" },
        "estado": { ".validate": "newData.isString() && (newData.val() == 'activo' || newData.val() == 'fallecido' || newData.val() == 'delegado' || newData.val() == 'historico')" }
      } }
    },

    // Guia 13. Imagenes en base64 comprimido o URL; tags por campana.
    "galeria": {
      "$camp": {
        "imagenes": { "$id": {
          ".write": true,
          ".validate": "newData.hasChildren(['titulo', 'autor', 'estado'])",
          "titulo": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 120" },
          "estado": { ".validate": "newData.isString() && (newData.val() == 'pendiente' || newData.val() == 'aprobada' || newData.val() == 'denegada')" }
        } },
        "tags": { "$tag": { ".write": true, ".validate": "newData.isBoolean()" } }
      }
    },

    // Guia 14. /sesiones/{campana}/{id} con XP general y extra.
    "sesiones": {
      "$camp": { "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['num', 'titulo'])",
        "num": { ".validate": "newData.isNumber()" },
        "titulo": { ".validate": "newData.isString() && newData.val().length < 160" }
      } }
    },

    // Guia 15. Acontecimientos historicos de Base (sin XP).
    "eventos": {
      "$camp": { "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['titulo'])",
        "titulo": { ".validate": "newData.isString() && newData.val().length < 160" }
      } }
    },

    // Guia 9. Libro de deidades por campana (documento o markdown).
    "capilla": {
      "$camp": { ".write": true }
    },

    // Guia 16. Reglas, tips y mascota por campana.
    "taller": {
      "$camp": { ".write": true }
    },

    // Guia 18. /notificaciones/{campana}/{usuario}/{id}
    "notificaciones": {
      "$camp": { "$usuario": { "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['asunto', 'fecha', 'estado'])",
        "estado": { ".validate": "newData.isString() && (newData.val() == 'pendiente' || newData.val() == 'archivada')" }
      } } }
    },

    // Guia 26. Registro de acciones importantes. /registros/{campana}/{id}
    "registros": {
      "$camp": { "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['tipo', 'fecha'])"
      } }
    }
  }
}
