---
// Barra superior fija con textura de madera y bookmarks por categoría.
// En Fase 0 los bookmarks son placeholders (sin permisos ni rutas reales todavía).
const base = import.meta.env.BASE_URL; // p.ej. '/Phaingea_Wiki' (sin barra final)
const woodUrl = `${base.replace(/\/$/, '')}/textures/wood.png`;
const bookmarks = [
  { key: 'inicio', label: 'Inicio', color: '#c9a45a' },
  { key: 'deidades', label: 'Deidades', color: '#b98cc0' },
  { key: 'regiones', label: 'Regiones', color: '#7fae6f' },
  { key: 'personajes', label: 'Personajes', color: '#d79a5b' },
  { key: 'galeria', label: 'Galería', color: '#6fa6c9' },
  { key: 'sesiones', label: 'Sesiones', color: '#c98a6f' },
  { key: 'notificaciones', label: 'Notificaciones', color: '#c9c06f' },
  { key: 'perfil', label: 'Perfil', color: '#b0a48f' },
];
---

<header class="topbar" style={`--wood: url("${woodUrl}")`}>
  <div class="brand">PHAINGEA</div>
  <nav class="bookmarks">
    {
      bookmarks.map((b) => (
        <span class="bookmark" style={`--bm: ${b.color}`}>
          {b.label}
        </span>
      ))
    }
  </nav>
</header>

<style>
  .topbar {
    height: var(--topbar-h);
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0 1.5rem;
    position: sticky;
    top: 0;
    z-index: 50;
    /* Madera: textura gris tintada a marrón (multiply) + velo marrón translúcido encima */
    background-color: #6b4a2c;
    background-image:
      linear-gradient(180deg, rgba(92, 62, 38, 0.35), rgba(52, 33, 19, 0.6)),
      var(--wood);
    background-size: cover, cover;
    background-position: center, center;
    background-repeat: no-repeat, no-repeat;
    background-blend-mode: normal, multiply;
    border-bottom: 2px solid #1c120a;
    box-shadow: var(--shadow-soft);
  }
  .brand {
    font-family: var(--font-title);
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--gold);
    text-shadow: 0 1px 2px #000;
  }
  .bookmarks {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .bookmark {
    font-size: 0.85rem;
    color: var(--paper);
    padding: 0.35rem 0.7rem;
    border-radius: 0 0 8px 8px;
    background: color-mix(in srgb, var(--bm) 22%, #2a1c10);
    border-top: 3px solid var(--bm);
    cursor: pointer;
    transition: transform 0.18s var(--ease), background 0.18s var(--ease);
    user-select: none;
  }
  .bookmark:hover {
    transform: translateY(2px);
    background: color-mix(in srgb, var(--bm) 38%, #2a1c10);
  }
</style>
