---
// Vista "Sala de Pociones": la Mesa de alquimia interactiva (app HTML autónoma,
// del zip que pasó el usuario). Se sirve desde public/pociones/ y se embebe por
// iframe a pantalla completa para aislar sus custom elements / estilos.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="view pociones" data-view="pociones" aria-label="Sala de Pociones" hidden>
  <!-- Se carga solo cuando la sala está activa (el conmutador pone src desde
       data-src) y se descarga (about:blank) al salir, para que la app no siga
       generando burbujas en segundo plano ni se acumulen. -->
  <iframe
    data-src={`${base}/pociones/index.html`}
    src="about:blank"
    title="Mesa de alquimia interactiva"
  ></iframe>
</section>

<style>
  .pociones {
    width: 100%;
    height: calc(100vh - var(--topbar-h));
  }
  .pociones iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: transparent; /* la app de alquimia flota sobre las estrellas */
  }
</style>
