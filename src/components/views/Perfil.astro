---
// Vista Perfil (diario personal). La sección es Astro (para el conmutador del
// SPA); el contenido es una isla React que lee el usuario de la SESIÓN
// ($user) y muestra su nombre + estados vacíos (sin campañas, sin personaje).
import PerfilContent from './PerfilContent.jsx';
---

<section class="view" data-view="perfil" hidden aria-label="Perfil">
  <div class="room">
    <header class="room-head">
      <p class="room-kicker">Diario personal</p>
      <h2 class="room-title">Perfil</h2>
      <p class="room-sub">Quién eres en la mesa y quién eres en la aventura.</p>
    </header>
    <PerfilContent client:load />
  </div>
</section>
