---
// Vista Regiones (sala de cartografía). Sin datos de muestra: mesa vacía a la
// espera del mapamundi real de Phaingea.
---

<section class="view" data-view="regiones" hidden aria-label="Regiones">
  <div class="room">
    <header class="room-head">
      <p class="room-kicker">Sala de cartografía</p>
      <h2 class="room-title">Regiones</h2>
      <p class="room-sub">La mesa de cartografía, lista para el mapamundi de Phaingea.</p>
    </header>

    <div class="panel mapa" aria-label="Mapamundi (vacío)">
      <span class="mapa-nota mono">Sin mapa cargado</span>
    </div>

    <div class="empty" style="min-height:26vh">
      <div class="ico">🗺️</div>
      <p>No hay regiones registradas.</p>
    </div>
  </div>
</section>

<style>
  .mapa {
    position: relative;
    min-height: 300px;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 50% 30%, rgba(201, 164, 90, 0.1), transparent 60%),
      linear-gradient(160deg, rgba(74, 51, 32, 0.6), rgba(26, 18, 11, 0.9));
  }
  .mapa-nota {
    position: absolute; right: 0.9rem; bottom: 0.7rem;
    font-size: 0.66rem; color: var(--stone); letter-spacing: 0.08em;
  }
</style>
