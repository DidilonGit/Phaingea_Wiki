---
// Vista Personajes (archivador). Sin datos de muestra: estado vacío hasta que
// haya personajes reales (vendrán de la base de datos por campaña).
---

<section class="view" data-view="personajes" hidden aria-label="Personajes">
  <div class="room">
    <header class="room-head">
      <p class="room-kicker">Archivador</p>
      <h2 class="room-title">Personajes</h2>
      <p class="room-sub">Las fichas de los héroes de cada campaña.</p>
    </header>
    <div class="empty">
      <div class="ico">🗄️</div>
      <p>El archivador está vacío. Aún no hay personajes.</p>
    </div>
  </div>
</section>
