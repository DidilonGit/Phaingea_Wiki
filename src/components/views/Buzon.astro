---
// Vista BUZÓN (guía §18): rincón de correspondencia con el sobre de cartas
// pendientes, la carta ampliada y el álbum de archivadas. Toda la lógica vive
// en la isla BuzonView. Sin título de sala (guía §3).
//
// CÓMO EDITAR:
//  · Datos -> /notificaciones/{campanaId}/{usuario} (src/lib/db/notificaciones.js).
//  · Quién genera avisos -> llamadas a notificar() desde sesiones y galería.
import BuzonView from '../BuzonView.jsx';
---

<section class="view" data-view="buzon" hidden aria-label="Buzón">
  <div class="room">
    <header class="room-head">
      <p class="room-sub">Las cartas de tus campañas, esperando junto al fuego.</p>
    </header>
    <BuzonView client:load />
  </div>
</section>
