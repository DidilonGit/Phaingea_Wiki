---
// Vista Notificaciones (registro). Sin datos de muestra: estado vacío hasta que
// haya eventos reales.
---

<section class="view" data-view="notificaciones" hidden aria-label="Notificaciones">
  <div class="room">
    <header class="room-head">
      <p class="room-kicker">Registro</p>
      <h2 class="room-title">Notificaciones</h2>
      <p class="room-sub">Los avisos de tus campañas.</p>
    </header>
    <div class="empty">
      <div class="ico">🔔</div>
      <p>No tienes notificaciones.</p>
    </div>
  </div>
</section>
