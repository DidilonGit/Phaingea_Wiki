---
// Vista PODIOS (guía §11) — LEYENDAS en Base de Phaingea (§12).
// Toda la sala vive en la isla PodiosView: filtros, grupos, navegación
// circular, podio con focos, diario y comentarios. Sin título de sala (§3).
//
// CÓMO EDITAR:
//  · Datos -> /personajes/{campanaId} (src/lib/db/personajes.js).
//  · Interfaz -> src/components/PodiosView.jsx.
import PodiosView from '../PodiosView.jsx';
---

<section class="view" data-view="podios" hidden aria-label="Podios">
  <div class="room">
    <!-- ranura fija de moderación de la sala (BotonMod sala) -->
    <div class="room-mod"></div>
    <header class="room-head">
      <p class="room-sub">Los héroes de la campaña, uno a uno sobre el podio.</p>
    </header>
    <PodiosView client:load />
  </div>
</section>
