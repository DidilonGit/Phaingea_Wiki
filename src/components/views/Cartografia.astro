---
// Vista CARTOGRAFÍA (guía §10): sala de mapas. La escena (marco de madera y
// herramientas colgadas) y toda la interacción viven en la isla MapaViewer:
// arrastrar/zoom, pines, lupa, compás, paño, información del lugar, lista de
// lugares y comentarios del lugar activo. Sin título de sala (guía §3).
//
// CÓMO EDITAR:
//  · Datos -> /lugares/{campanaId} (ver src/lib/db/lugares.js).
//  · Comportamiento e interfaz -> src/components/MapaViewer.jsx.
import MapaViewer from '../MapaViewer.jsx';
---

<section class="view carto" data-view="cartografia" hidden aria-label="Cartografía">
  <div class="room">
    <!-- ranura fija de moderación de la sala (BotonMod sala) -->
    <div class="room-mod"></div>
    <header class="room-head">
      <p class="room-sub">El mapamundi de Phaingea, desplegado sobre la mesa de cartografía. Sigue los pines para adentrarte en cada tierra.</p>
    </header>

    <MapaViewer client:load />
  </div>
</section>
