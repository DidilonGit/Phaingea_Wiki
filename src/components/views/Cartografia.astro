---
// Vista CARTOGRAFÍA (guía §10): sala de mapas. El mapa se ve de frente dentro
// de un marco grueso de madera; a los lados, herramientas colgadas de ganchos
// metálicos (lupa, compás y paño). El fondo estrellado sigue visible alrededor.
// Sin título de sala (guía §3).
//
// CÓMO EDITAR:
//  · El visor real (arrastrar/zoom/pines) llega en T27 -> hueco .mapa-hueco.
//  · Las herramientas se activan en T28 (lupa) y T29 (compás y paño); aquí
//    solo cuelgan del gancho con su hover.
//  · Info del lugar y lista alfabética: T30. Comentarios por lugar: T31.
const HERRAMIENTAS = [
  { key: 'lupa', nombre: 'Lupa', lado: 'izq' },
  { key: 'compas', nombre: 'Compás', lado: 'der' },
  { key: 'pano', nombre: 'Paño', lado: 'der' },
];
const REGIONES = [1, 2, 3, 4, 5, 6];
const COMENTARIOS = [1, 2];
---

<section class="view carto" data-view="cartografia" hidden aria-label="Cartografía">
  <div class="room">
    <header class="room-head">
      <p class="room-sub">El mapamundi de Phaingea, desplegado sobre la mesa de cartografía. Sigue los pines para adentrarte en cada tierra.</p>
    </header>

    <!-- conjunto: herramientas colgadas + mapa enmarcado -->
    <div class="carto-conjunto">
      <div class="panel-herramientas izq">
        {HERRAMIENTAS.filter((h) => h.lado === 'izq').map((h) => (
          <button class={`herramienta ${h.key}`} title={h.nombre} aria-label={h.nombre} disabled>
            <span class="gancho" aria-hidden="true"></span>
            <span class="util" aria-hidden="true"></span>
            <span class="h-nombre">{h.nombre}</span>
          </button>
        ))}
      </div>

      <div class="marco-madera">
        <div class="mapa-hueco">
          <div class="mapa-vacio mono">Imagen de mapa no disponible</div>
        </div>
      </div>

      <div class="panel-herramientas der">
        {HERRAMIENTAS.filter((h) => h.lado === 'der').map((h) => (
          <button class={`herramienta ${h.key}`} title={h.nombre} aria-label={h.nombre} disabled>
            <span class="gancho" aria-hidden="true"></span>
            <span class="util" aria-hidden="true"></span>
            <span class="h-nombre">{h.nombre}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="grid" style="margin-top:1.4rem;">
      {REGIONES.map(() => (
        <article class="panel">
          <h3 class="reg-nom">WIP</h3>
          <p class="reg-desc">WIP</p>
        </article>
      ))}
    </div>

    <div class="comments">
      <h3>Comentarios</h3>
      {COMENTARIOS.map(() => (
        <div class="comment">
          <p class="meta"><b>WIP</b></p>
          <p>WIP</p>
        </div>
      ))}
      <form class="comment-form" onsubmit="return false;">
        <input type="text" placeholder="Deja tu comentario sobre el mapa…" aria-label="Escribir comentario" />
        <button class="btn" type="submit">Comentar</button>
      </form>
    </div>
  </div>
</section>

<style>
  /* ---- disposición: herramientas · mapa · herramientas ---- */
  .carto-conjunto {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: clamp(0.6rem, 2vw, 1.6rem);
  }

  /* ---- marco grueso de madera ---- */
  .marco-madera {
    position: relative;
    padding: 18px;
    border-radius: 6px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(0, 0, 0, 0.35)),
      linear-gradient(135deg, #6b4a2c, #3a2618 70%);
    box-shadow:
      0 16px 40px rgba(0, 0, 0, 0.6),
      inset 0 0 0 2px rgba(201, 164, 90, 0.35),
      inset 0 2px 0 rgba(255, 255, 255, 0.12);
  }
  /* bisel interior del marco */
  .marco-madera::after {
    content: '';
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(0, 0, 0, 0.5);
    border-radius: 3px;
    pointer-events: none;
  }
  .mapa-hueco {
    position: relative;
    min-height: min(52vh, 460px);
    border-radius: 3px;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 50% 30%, rgba(201, 164, 90, 0.12), transparent 60%),
      linear-gradient(160deg, rgba(74, 51, 32, 0.7), rgba(26, 18, 11, 0.92));
    display: grid;
    place-items: center;
  }
  .mapa-vacio { color: var(--stone); font-size: 0.8rem; letter-spacing: 0.08em; }

  /* ---- herramientas colgadas de ganchos metálicos ---- */
  .panel-herramientas {
    display: grid;
    gap: 1.4rem;
    padding-top: 0.6rem;
  }
  .herramienta {
    position: relative;
    width: 54px;
    display: grid;
    justify-items: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: not-allowed; /* se activan en T28/T29 */
    opacity: 0.9;
  }
  .gancho {
    width: 12px;
    height: 14px;
    border: 2px solid #9aa0a8;
    border-top: 0;
    border-radius: 0 0 8px 8px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }
  .util {
    width: 34px;
    height: 34px;
    margin-top: -2px;
    filter: drop-shadow(0 3px 5px rgba(0, 0, 0, 0.6));
  }
  /* lupa: aro con mango */
  .herramienta.lupa .util {
    border-radius: 50%;
    border: 3px solid #b9a27a;
    background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.35), rgba(180, 200, 220, 0.18));
    position: relative;
  }
  .herramienta.lupa .util::after {
    content: '';
    position: absolute;
    right: -4px;
    bottom: -10px;
    width: 5px;
    height: 16px;
    border-radius: 3px;
    background: linear-gradient(#8a6d34, #4a3a1a);
    transform: rotate(-35deg);
  }
  /* compás: dos patas en A */
  .herramienta.compas .util {
    background: none;
    position: relative;
  }
  .herramienta.compas .util::before,
  .herramienta.compas .util::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 16px;
    width: 3px;
    height: 30px;
    border-radius: 2px;
    background: linear-gradient(#c9b48a, #6b5730);
    transform-origin: top center;
  }
  .herramienta.compas .util::before { transform: rotate(-16deg); }
  .herramienta.compas .util::after { transform: rotate(16deg); }
  /* paño: tela colgando */
  .herramienta.pano .util {
    border-radius: 4px 4px 10px 10px;
    background: linear-gradient(160deg, #9c8f78, #6d6353);
    clip-path: polygon(0 0, 100% 0, 100% 82%, 76% 100%, 50% 86%, 24% 100%, 0 82%);
  }
  .h-nombre {
    margin-top: 0.35rem;
    font-family: ui-monospace, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .herramienta:hover .h-nombre { color: var(--gold); }

  /* ---- tarjetas de región ---- */
  .reg-nom {
    font-family: var(--font-title);
    color: var(--gold-soft);
    letter-spacing: 0.04em;
    margin: 0 0 0.4rem;
    font-size: 1.15rem;
  }
  .reg-desc { color: var(--paper); font-family: var(--font-body); line-height: 1.5; font-size: 0.9rem; }

  @media (max-width: 720px) {
    .carto-conjunto { grid-template-columns: 1fr; }
    .panel-herramientas { grid-auto-flow: column; justify-content: center; }
  }
</style>
