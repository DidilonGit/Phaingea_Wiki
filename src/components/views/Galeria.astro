---
// Vista Galería (sala de exposición). Sin datos de muestra: estado vacío hasta
// que se suban imágenes reales (con tags y filtros).
---

<section class="view" data-view="galeria" hidden aria-label="Galería">
  <div class="room">
    <header class="room-head">
      <p class="room-kicker">Sala de exposición</p>
      <h2 class="room-title">Galería</h2>
      <p class="room-sub">Ilustraciones del mundo, cada una en su marco.</p>
    </header>
    <div class="empty">
      <div class="ico">🖼️</div>
      <p>La galería está vacía.</p>
    </div>
  </div>
</section>
