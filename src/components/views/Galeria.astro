---
// Vista GALERÍA (guía §13): museo de imágenes con marcos, filtros por tags,
// vista ampliada, subida con aprobación y moderación. Toda la lógica vive en
// la isla GaleriaView. Sin título de sala (guía §3).
//
// CÓMO EDITAR:
//  · Datos -> /galeria/{campanaId} (src/lib/db/galeria.js).
//  · Interfaz -> src/components/GaleriaView.jsx.
import GaleriaView from '../GaleriaView.jsx';
---

<section class="view" data-view="galeria" hidden aria-label="Galería">
  <div class="room">
    <!-- ranura fija de moderación de la sala (BotonMod sala) -->
    <div class="room-mod"></div>
    <header class="room-head">
      <p class="room-sub">Un museo de ilustraciones del mundo: retratos, paisajes y reliquias. Filtra por tema o toca un cuadro para ampliarlo.</p>
    </header>
    <GaleriaView client:load />
  </div>
</section>
