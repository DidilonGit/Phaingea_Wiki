---
// Vista Moderación (sala de gestión). Solo llega aquí quien ve su banderín
// (gating por rol en TopBar). Aquí va lo que NO se ve en ninguna sala:
// usuarios y roles, solicitudes pendientes, registros y herencia de contenido.
//
// La GESTIÓN DE CAMPAÑAS (nombre, colores, tipografía, logo…) vive en el botón
// «Moderar categoría» del Observatorio, que es donde se nota lo que cambia.
// Sin título de sala (guía §3).
import ModPanel from '../mod/ModPanel.jsx';

---

<section class="view" data-view="moderacion" hidden aria-label="Moderación">
  <div class="room">
    <header class="room-head">
      <p class="room-kicker">Sala de gestión</p>
      <p class="room-sub">Administración de la web y de las campañas. Los másteres ven solo lo suyo; el owner, todo.</p>
    </header>

    <ModPanel client:load />
  </div>
</section>

<style>
  .mod-titulo {
    font-family: var(--font-title);
    color: var(--gold-soft);
    letter-spacing: 0.04em;
    margin: 0 0 0.6rem;
    font-size: 1.1rem;
  }
</style>
