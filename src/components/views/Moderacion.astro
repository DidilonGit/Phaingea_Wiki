---
// Vista Moderación (sala de gestión). Solo llega aquí quien ve su banderín
// (gating por rol en TopBar). Gestión de campañas real (T08); el resto de
// paneles llegan en T60 (jugadores/roles) y T61 (solicitudes/registros).
// Sin título de sala (guía §3).
import ModCampanas from '../mod/ModCampanas.jsx';
import ModPanel from '../mod/ModPanel.jsx';

---

<section class="view" data-view="moderacion" hidden aria-label="Moderación">
  <div class="room">
    <header class="room-head">
      <p class="room-kicker">Sala de gestión</p>
      <p class="room-sub">Administración de la web y de las campañas. Los másteres ven solo lo suyo; el owner, todo.</p>
    </header>

    <article class="panel" style="margin-bottom:1.1rem;">
      <h3 class="mod-titulo">Gestión de campañas</h3>
      {/* client:load (no visible): las secciones ocultas del SPA rompen el
          IntersectionObserver de client:visible */}
      <ModCampanas client:load />
    </article>

    <ModPanel client:load />
  </div>
</section>

<style>
  .mod-titulo {
    font-family: var(--font-title);
    color: var(--gold-soft);
    letter-spacing: 0.04em;
    margin: 0 0 0.6rem;
    font-size: 1.1rem;
  }
</style>
