---
// Vista SESIONES (guía §14) — EVENTOS en Base de Phaingea (§15).
// Cuaderno de viaje con índice interno; toda la lógica vive en la isla
// SesionesView. Sin título de sala (guía §3).
//
// CÓMO EDITAR:
//  · Datos -> /sesiones/{campanaId} y /eventos/{campanaId}
//             (src/lib/db/sesiones.js).
//  · Interfaz -> src/components/SesionesView.jsx.
import SesionesView from '../SesionesView.jsx';
---

<section class="view" data-view="sesiones" hidden aria-label="Sesiones">
  <div class="room">
    <!-- ranura fija de moderación de la sala (BotonMod sala) -->
    <div class="room-mod"></div>
    <header class="room-head">
      <p class="room-sub">Cada página de este tomo recoge una sesión: lo vivido, la experiencia repartida y las heridas que dejó.</p>
    </header>
    <SesionesView client:load />
  </div>
</section>
