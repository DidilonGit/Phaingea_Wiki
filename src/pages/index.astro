---
// Observatorio / página principal (Fase 0: landing de cimientos).
import RoomLayout from '../layouts/RoomLayout.astro';
import FirebaseStatus from '../components/FirebaseStatus.jsx';
import StarsCanvas from '../components/StarsCanvas.jsx';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<RoomLayout title="Phaingea — Observatorio">
  <StarsCanvas client:load speedMultiplier={0.4} />
  <section class="hero">
    <div class="halo"></div>
    <h1>Phaingea</h1>
    <p class="tagline">Archivo del universo · enciclopedia de campañas</p>

    <div class="status">
      <FirebaseStatus client:load />
    </div>

    <p class="note">
      Fase 0 · Cimientos. El proyecto Astro está montado, conectado a Firebase y
      listo para desplegarse en GitHub Pages. Las salas y el dial llegan en las
      siguientes fases.
    </p>

    <a class="cta" href={`${base}/observatorio.html`}>Ver el observatorio (prototipo) →</a>
  </section>
</RoomLayout>

<style>
  .hero {
    position: relative;
    z-index: 1; /* por encima del canvas de estrellas (z-index:0) */
    max-width: 720px;
    margin: 8vh auto 0;
    text-align: center;
  }
  .halo {
    position: absolute;
    inset: -40% 50% auto;
    width: 320px;
    height: 320px;
    margin: 0 auto;
    left: 0;
    right: 0;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(201, 164, 90, 0.28), transparent 65%);
    filter: blur(6px);
    pointer-events: none;
  }
  h1 {
    position: relative;
    font-family: var(--font-title);
    font-size: clamp(3rem, 8vw, 5.5rem);
    letter-spacing: 0.1em;
    margin: 0;
    color: var(--gold);
    text-shadow: 0 2px 24px rgba(201, 164, 90, 0.35);
  }
  .tagline {
    color: var(--parchment);
    opacity: 0.85;
    margin-top: 0.5rem;
    letter-spacing: 0.05em;
  }
  .status {
    margin: 2rem 0 1.5rem;
  }
  .note {
    max-width: 460px;
    margin: 0 auto;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--stone);
  }
  .cta {
    display: inline-block;
    margin-top: 1.8rem;
    padding: 0.7rem 1.4rem;
    border: 1px solid rgba(201, 164, 90, 0.55);
    border-radius: 999px;
    color: var(--gold);
    font-family: var(--font-ui);
    letter-spacing: 0.04em;
    background: rgba(201, 164, 90, 0.06);
    transition: background 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .cta:hover {
    background: rgba(201, 164, 90, 0.16);
    transform: translateY(-2px);
  }
</style>
